{
  "info": {
    "_postman_id": "bb84153b-cefd-4885-b2fb-918340ddcb4c",
    "name": "Bus Ticketing \u2014 Booking Service",
    "description": "Real, runnable requests against the Booking Service vertical slice. The collection-level pre-request script mints a dev JWT and attaches it as a Bearer token to every request automatically \u2014 see 'Pre-request Script' on the collection itself. Run seed-demo-data.sql first so tripId/seat examples below actually exist.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection Pre-request Script",
          "// Mints a fresh dev JWT (HS256) matching the Booking Service's",
          "// appsettings.json Jwt:Issuer / Jwt:Audience / Jwt:SigningKey and attaches",
          "// it as a Bearer token to EVERY request in this collection automatically \u2014",
          "// no separate \"run a login request first\" step needed for local dev/testing.",
          "//",
          "// IMPORTANT: this only works because the signing key here matches the",
          "// dev-only key baked into docker-compose.yml / appsettings.json. Never reuse",
          "// this trick against a real deployed environment's secret.",
          "",
          "const signingKey = pm.environment.get('jwtSigningKey') || 'dev-only-signing-key-change-me-32chars-minimum';",
          "const issuer = pm.environment.get('jwtIssuer') || 'https://identity.bus-ticketing.local';",
          "const audience = pm.environment.get('jwtAudience') || 'bus-ticketing-api';",
          "const customerId = pm.environment.get('customerId') || '00000000-0000-0000-0000-000000000001';",
          "",
          "function base64url(wordArray) {",
          "    return CryptoJS.enc.Base64.stringify(wordArray)",
          "        .replace(/=+$/, '')",
          "        .replace(/\\+/g, '-')",
          "        .replace(/\\//g, '_');",
          "}",
          "",
          "const header = { alg: 'HS256', typ: 'JWT' };",
          "const now = Math.floor(Date.now() / 1000);",
          "const payload = {",
          "    sub: customerId,",
          "    iss: issuer,",
          "    aud: audience,",
          "    iat: now,",
          "    exp: now + 3600,",
          "    role: 'Customer'",
          "};",
          "",
          "const encodedHeader = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "const encodedPayload = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "const toSign = encodedHeader + '.' + encodedPayload;",
          "const signature = base64url(CryptoJS.HmacSHA256(toSign, signingKey));",
          "const token = toSign + '.' + signature;",
          "",
          "pm.environment.set('access_token', token);",
          "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{baseUrl}}"
    }
  ],
  "item": [
