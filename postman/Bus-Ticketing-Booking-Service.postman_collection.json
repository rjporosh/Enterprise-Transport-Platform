              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Aggregates Postgres, RabbitMQ, and Redis health checks."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "Search trips (Dhaka -> Chattogram)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has items array', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.items).to.be.an('array');",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.items && body.items.length > 0) {",
                  "    pm.environment.set('tripId', body.items[0].tripId);",
                  "    console.log('Captured tripId ->', body.items[0].tripId);",
                  "}",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trips/search?origin=Dhaka&destination=Chattogram&date=2026-08-15&page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trips",
                "search"
              ],
              "query": [
                {
                  "key": "origin",
                  "value": "Dhaka"
                },
                {
                  "key": "destination",
                  "value": "Chattogram"
                },
                {
                  "key": "date",
                  "value": "2026-08-15"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "Public endpoint \u2014 no auth required, though the collection will still attach a bearer token (harmless, ignored by this endpoint)."
          },
          "response": []
        }
      ]
    },
    {
