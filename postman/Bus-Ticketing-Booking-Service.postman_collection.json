      "item": [
        {
          "name": "Create booking (hold seats)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Booking is PendingPayment', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('PendingPayment');",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.bookingId) {",
                  "    pm.environment.set('bookingId', body.bookingId);",
                  "    console.log('Captured bookingId ->', body.bookingId);",
                  "}",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
