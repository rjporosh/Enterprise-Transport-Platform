      "bus":          { "Destinations": { "primary": { "Address": "http://localhost:5201/" } } },
      "route":        { "Destinations": { "primary": { "Address": "http://localhost:5401/" } } },
      "payment":      { "Destinations": { "primary": { "Address": "http://localhost:5501/" } } },
      "notification": { "Destinations": { "primary": { "Address": "http://localhost:5301/" } } },
      "ticketing":    { "Destinations": { "primary": { "Address": "http://localhost:5701/" } } }
    }
  }
}
