{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Yarp": "Debug" }
    }
  },

  "Jwt": {
    "SigningKey": "dev-only-signing-key-change-me-32chars-minimum"
  },

