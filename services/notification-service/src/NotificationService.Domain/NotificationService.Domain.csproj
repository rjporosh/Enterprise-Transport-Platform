<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NotificationService.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same rule as every other service in this solution: Domain only takes on
         MediatR.Contracts (for INotification), never the full MediatR pipeline,
         EF Core, or ASP.NET. See BookingService.Domain.csproj for precedent. -->
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>

</Project>
