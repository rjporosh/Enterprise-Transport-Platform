{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "NotificationDb": "Host=localhost;Port=5432;Database=notification_service;Username=postgres;Password=postgres"
  },
  "Database": {
    "Provider": "Postgres"
  },

  "Jwt": {
    "Issuer": "bus-ticketing-auth-service",
    "Audience": "bus-ticketing-platform",
    "SigningKey": ""
  },

  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "notification.events",
    "UpstreamBindings": [
      { "Exchange": "auth.events", "RoutingKey": "auth.user.registered" },
      { "Exchange": "auth.events", "RoutingKey": "auth.password.changed" },
      { "Exchange": "auth.events", "RoutingKey": "auth.user.locked.out" },
      { "Exchange": "booking.events", "RoutingKey": "booking.created" },
      { "Exchange": "booking.events", "RoutingKey": "booking.confirmed" },
      { "Exchange": "booking.events", "RoutingKey": "booking.cancelled" },
      { "Exchange": "payment.events", "RoutingKey": "payment.succeeded" },
      { "Exchange": "payment.events", "RoutingKey": "payment.failed" },
      { "Exchange": "ticket.events", "RoutingKey": "ticket.issued" }
    ]
  },

  "UserDirectory": {
    "BaseUrl": "",
    "TimeoutSeconds": 3
  },

  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UserName": "",
    "Password": "",
    "UseStartTls": false,
    "FromAddress": "no-reply@bus-ticketing.local",
    "FromDisplayName": "Bus Ticketing"
  },

  "Sms": {
    "Provider": "GenericHttp",
    "FromNumber": "",
    "TwilioAccountSid": "",
    "TwilioAuthToken": "",
    "GenericHttpEndpoint": "",
    "GenericHttpApiKey": "",
    "Bd": {
      "Endpoint": "",
      "ApiToken": "",
      "SenderId": "",
      "TokenField": "api_token",
      "RecipientField": "msisdn",
      "MessageField": "sms",
      "SenderField": "sid"
    }
  },

  "Push": {
    "FirebaseProjectId": "",
    "ServiceAccountJsonPath": ""
  },

  "Retry": {
    "MaxAttempts": 3,
    "BaseDelayMilliseconds": 500
  },

  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  }
}
