<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuthService.LoadTests.Nbomber</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Deliberately NOT referenced from AuthService.sln — this is a
      standalone tool you run with `dotnet run`, same way you would run k6
      or jmeter, not something the app's build/test pipeline compiles as
      part of every PR. See ../README.md.
    -->
    <PackageReference Include="NBomber" Version="5.8.0" />
    <PackageReference Include="NBomber.Http" Version="5.8.0" />
  </ItemGroup>

</Project>
