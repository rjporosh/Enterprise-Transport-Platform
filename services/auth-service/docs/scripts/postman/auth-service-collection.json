{
  "info": {
    "name": "Auth Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "authEmail", "value": "test@example.com" },
    { "key": "authPassword", "value": "correct-horse-battery-staple" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{authEmail}}\",\"password\":\"{{authPassword}}\",\"firstName\":\"Test\",\"lastName\":\"User\"}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] } }
        },
        {
          "name": "Login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{authEmail}}\",\"password\":\"{{authPassword}}\"}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] } }
        },
        {
          "name": "Refresh Token",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }, "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth","refresh"] } }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }, "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth","logout"] } }
        },
        {
          "name": "Get Current User",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth","me"] } }
        }
      ]
    },
    {
      "name": "Password",
      "item": [
        {
          "name": "Change Password",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\"currentPassword\":\"{{authPassword}}\",\"newPassword\":\"new-secure-pass-123\"}" }, "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth","change-password"] } }
        },
        {
          "name": "Forgot Password",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{authEmail}}\"}" }, "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth","forgot-password"] } }
        },
        {
          "name": "Reset Password",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"token\":\"<reset-token-from-email>\",\"newPassword\":\"new-secure-pass-456\"}" }, "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth","reset-password"] } }
        }
      ]
    },
    {
      "name": "OTP",
      "item": [
        {
          "name": "Request OTP",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"userId\":\"<user-id>\",\"channel\":\"email\",\"destination\":\"user@example.com\"}" }, "url": { "raw": "{{baseUrl}}/auth/otp/request", "host": ["{{baseUrl}}"], "path": ["auth","otp","request"] } }
        },
        {
          "name": "Verify OTP",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"userId\":\"<user-id>\",\"code\":\"123456\",\"channel\":\"email\"}" }, "url": { "raw": "{{baseUrl}}/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["auth","otp","verify"] } }
        }
      ]
    },
    {
      "name": "Security Questions",
      "item": [
        {
          "name": "Configure Security Questions",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\"questionAnswers\":{\"<question-id-1>\":\"Answer1\",\"<question-id-2>\":\"Answer2\",\"<question-id-3>\":\"Answer3\"}}" }, "url": { "raw": "{{baseUrl}}/auth/security-questions/configure", "host": ["{{baseUrl}}"], "path": ["auth","security-questions","configure"] } }
        },
        {
          "name": "Verify Security Questions",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"userId\":\"<user-id>\",\"questionAnswers\":{\"<question-id-1>\":\"answer1\",\"<question-id-2>\":\"answer2\",\"<question-id-3>\":\"answer3\"}}" }, "url": { "raw": "{{baseUrl}}/auth/security-questions/verify", "host": ["{{baseUrl}}"], "path": ["auth","security-questions","verify"] } }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Permissions",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/permissions", "host": ["{{baseUrl}}"], "path": ["admin","permissions"] } }
        },
        {
          "name": "Create Permission",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\"name\":\"users.create\",\"description\":\"Create users\",\"module\":\"Users\"}" }, "url": { "raw": "{{baseUrl}}/admin/permissions", "host": ["{{baseUrl}}"], "path": ["admin","permissions"] } }
        },
        {
          "name": "List Modules",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/modules", "host": ["{{baseUrl}}], "path": ["admin","modules"] } }
        },
        {
          "name": "List Roles",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/roles", "host": ["{{baseUrl}}], "path": ["admin","roles"] } }
        }
      ]
    }
  ]
}
