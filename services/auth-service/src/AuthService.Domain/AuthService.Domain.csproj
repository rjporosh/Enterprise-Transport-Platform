<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuthService.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Only dependency Domain takes on: MediatR.Contracts gives us INotification
      so domain events can be dispatched via MediatR without pulling the full
      MediatR pipeline, EF Core, or ASP.NET into Domain.
    -->
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>

</Project>
