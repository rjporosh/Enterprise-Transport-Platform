{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "BusDb": "Host=localhost;Port=5432;Database=bus_service;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "bus-service:"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "bus.events"
  },
  "Jwt": {
    "Issuer": "https://identity.bus-ticketing.local",
    "Audience": "bus-ticketing-api",
    "SigningKey": "REPLACE_WITH_A_SECRET_AT_LEAST_32_CHARS_LONG_IN_PROD"
  },
  "Logging": {
    "FileLogsDirectory": "../../logs",
    "EnableQueryLogging": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*"
}
