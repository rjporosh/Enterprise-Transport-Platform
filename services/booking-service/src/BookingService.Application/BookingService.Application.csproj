<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BookingService.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.10.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <!--
      Yes, this makes Application aware of EF Core's DbSet<T>/DbUpdateConcurrencyException
      types. That's a deliberate, pragmatic deviation from textbook Clean Architecture
      (see docs/adr/0006-pragmatic-orm-leakage.md): it buys CQRS handlers direct,
      efficient LINQ projections instead of a repository-per-aggregate layer that
      would just wrap EF Core anyway. Application still has zero dependency on
      Npgsql/the specific provider or on Infrastructure itself.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookingService.Domain\BookingService.Domain.csproj" />
  </ItemGroup>

</Project>
