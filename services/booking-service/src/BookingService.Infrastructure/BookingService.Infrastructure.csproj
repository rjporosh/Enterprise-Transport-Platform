<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BookingService.Infrastructure</RootNamespace>
    <NoWarn>NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <!--
      Database portability — the runtime "Database:Provider" switch in
      DependencyInjection.cs picks which one is instantiated. Postgres is the
      primary/default provider; the others are always referenced so switching
      is configuration-only. See docs/programmers-guide/database-provider-factory.md.
    -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <!-- Pomelo has no official EF Core 10 release yet (same as bus/auth); suppressed deliberately. -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" NoWarn="NU1608" />
    <!--
      SQLite is a supported provider name in the factory switch but its package
      is not referenced by default: SQLitePCLRaw.lib.e_sqlite3 2.1.11 (its only
      native asset) carries GHSA-2m69-gcr7-jv3q with no patched release yet.
      To use it, add Microsoft.EntityFrameworkCore.Sqlite and regenerate the
      migrations for SQLite. See docs/programmers-guide/database-provider-factory.md.
    -->
    <!-- Quartz.NET — ExpiredHoldSweepJob (releases unpaid seat holds). -->
    <PackageReference Include="Quartz" Version="3.13.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pins the transitive System.Security.Cryptography.Xml (pulled in at 9.0.0 despite
         net10.0 targeting) up to the version patched for the XML-encryption DoS advisory
         CVE-2026-50648 / GHSA-23rf-6693-g89p (and the identical sibling GHSA IDs reported
         alongside it: 8q5v-6pqq-x66h, cvvh-rhrc-wg4q, g8r8-53c2-pm3f, mmjf-rqrv-855v,
         w3x6-4m5h-cxqf, 37gx-xxp4-5rgx, 6588-8gv4-xfgh — all fixed together). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />

    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <!-- IMeterFactory (used by BookingMetrics) — referenced explicitly rather than relying on it arriving transitively. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <!-- Distributed cache-aside layer for SearchTrips (hot, read-heavy, tolerant of a few seconds of staleness). -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookingService.Application\BookingService.Application.csproj" />
    <!-- Platform shared kernel (M0): stable event routing keys + ambient correlation context. -->
    <ProjectReference Include="..\..\..\..\shared\contracts\Platform.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\shared\shared-kernel\Platform.SharedKernel.csproj" />
  </ItemGroup>

</Project>
