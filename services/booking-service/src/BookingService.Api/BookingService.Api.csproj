<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BookingService.Api</RootNamespace>
    <UserSecretsId>booking-service-secrets</UserSecretsId>
    <!-- NU1608: Pomelo 9.0.0 vs EF Core 10 (deliberate — see Infrastructure.csproj).
         Matches bus-service / route-service. -->
    <NoWarn>NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <!-- AspNetCore.HealthChecks.Rabbitmq 9.0.0 dropped its connection-string overload; .v6 kept it and targets RabbitMQ.Client v6.x, matching the RabbitMQ.Client 6.8.1 pinned above. -->
    <PackageReference Include="AspNetCore.HealthChecks.Rabbitmq.v6" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />

    <!-- Native minimal-API OpenAPI document generation (Microsoft.AspNetCore.OpenApi), served at /openapi/v1.json. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Pins the transitive Microsoft.OpenApi brought in by Microsoft.AspNetCore.OpenApi 10.0.0
         (which resolves to 2.0.0) up to the version patched for GHSA-v5pm-xwqc-g5wc /
         CVE-2026-49451 (stack overflow on circular schema refs). Direct reference wins
         over the transitive one under NuGet's nearest-wins rule. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Scalar renders that document as a modern, "click to try" API reference at /scalar. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.1.2" />

    <!-- Observability: traces + metrics via OpenTelemetry, exported over OTLP to the Aspire Dashboard / Jaeger / Prometheus. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.17.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- Npgsql.OpenTelemetry removed: Program.cs now subscribes to Npgsql's "Npgsql"
         ActivitySource directly via AddSource(), so this package (and its .AddNpgsql()
         extension, which collided with EFCore.PG's AddNpgsql<TContext>) is no longer needed. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookingService.Application\BookingService.Application.csproj">
      <ReferenceSourceTarget></ReferenceSourceTarget>
      <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\BookingService.Infrastructure\BookingService.Infrastructure.csproj">
      <ReferenceSourceTarget></ReferenceSourceTarget>
      <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\..\..\..\shared\shared-kernel\Platform.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Properties\launchSettings.json">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
