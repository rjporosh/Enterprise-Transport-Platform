<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RouteService.Infrastructure</RootNamespace>
    <!--
      NU1608: Pomelo.EntityFrameworkCore.MySql 9.0.0's declared dependency
      constraint (Microsoft.EntityFrameworkCore.Relational 9.x) doesn't cover
      the 10.0.0 resolved here. See the PackageReference comment below for
      why this is a deliberate, tracked suppression rather than a real bug.
      Suppressed at the project level (not just via the PackageReference's
      own NoWarn) because NU1608 is a whole-graph restore diagnostic that
      NuGet also reports against every project that references this one
      (RouteService.Api, RouteService.UnitTests, RouteService.IntegrationTests)
      even though none of them reference Pomelo directly — an item-level
      NoWarn on the Pomelo reference here doesn't reach those projects.
    -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" NoWarn="NU1608" />
    <!--
      Transitive dependency (pulled in by Microsoft.EntityFrameworkCore.SqlServer
      -> Microsoft.Data.SqlClient, for Always Encrypted XML key-store support)
      resolves to a version with a known high-severity DoS advisory. Pinned
      directly to a patched version to override it — NuGet resolves the
      highest version requested across the graph, so this wins over whatever
      Microsoft.Data.SqlClient asks for.
      10.0.6 was in the vulnerable range for the .NET July 2026 EncryptedXml
      DoS advisory (GHSA-23rf-6693-g89p / CVE-2026-50648, CVSS 7.5): affected
      versions >=10.0.0,<=10.0.9; fixed in 10.0.10 (verified against the
      published GitHub Security Advisory). Bumped here; re-verify with the
      .NET CLI's package vulnerability check once network access is available,
      since this was not restored/tested in this pass.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Polly" Version="8.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RouteService.Application\RouteService.Application.csproj" />
    <!-- Platform shared kernel (M0): stable event routing keys + ambient correlation context. -->
    <ProjectReference Include="..\..\..\..\shared\contracts\Platform.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\shared\shared-kernel\Platform.SharedKernel.csproj" />
  </ItemGroup>

</Project>
