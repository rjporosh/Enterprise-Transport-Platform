{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=payment_db;Username=postgres;Password=postgres"
  },
  "Database": {
    "Provider": "PostgreSQL"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "payment-service",
    "DefaultTtlSeconds": 300
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "payment.events"
  },
  "Jwt": {
    "Issuer": "http://localhost:5001",
    "Audience": "payment-service",
    "SigningKey": "super_secret_development_key_please_change_in_production"
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:3000", "http://localhost:8080" ]
  },
  "Bkash": {
    "AppKey": "",
    "AppSecret": "",
    "Username": "",
    "Password": "",
    "BaseUrl": "https://tokenized.sandbox.bka.sh/v1.2.0-beta",
    "CallbackUrl": "https://your-domain.com/api/v1/webhooks/bkash",
    "WebhookSecret": ""
  }
}
