{
  "info": {
    "name": "Payment Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Enterprise Payment Service API Collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5003" },
    { "key": "authToken", "value": "" }
  ],
  "item": [
    {
      "name": "Create Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" },
          { "key": "X-Correlation-Id", "value": "{{$randomUUID}}" },
          { "key": "X-Tenant-Id", "value": "11111111-1111-1111-1111-111111111111" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"TenantId\": \"11111111-1111-1111-1111-111111111111\",\n  \"CustomerId\": \"44444444-4444-4444-4444-444444444444\",\n  \"OrderReference\": \"ORDER-001\",\n  \"PaymentMethod\": \"Card\",\n  \"Amount\": 100.00,\n  \"Currency\": \"USD\",\n  \"IdempotencyKey\": \"idem-001\",\n  \"TtlMinutes\": 30\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/payments", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments"] }
      }
    },
    {
      "name": "Get Payment by ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/payments/{paymentId}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "{{paymentId}}"] }
      }
    },
    {
      "name": "Process Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ProviderReference\": \"provider-ref-001\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/payments/{paymentId}/process", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "{{paymentId}}", "process"] }
      }
    },
    {
      "name": "Confirm Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ProviderTransactionId\": \"txn-001\",\n  \"ProviderReference\": \"provider-ref-001\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/payments/{paymentId}/confirm", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "{{paymentId}}", "confirm"] }
      }
    },
    {
      "name": "Refund Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Amount\": 50.00,\n  \"Reason\": \"Customer requested refund\",\n  \"InitiatedByUserId\": \"user-001\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/payments/{paymentId}/refund", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "{{paymentId}}", "refund"] }
      }
    },
    {
      "name": "Search Payments",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/search?TenantId=11111111-1111-1111-1111-111111111111&Page=1&PageSize=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "payments", "search"],
          "query": [
            { "key": "TenantId", "value": "11111111-1111-1111-1111-111111111111" },
            { "key": "Page", "value": "1" },
            { "key": "PageSize", "value": "10" }
          ]
        }
      }
    }
  ]
}
