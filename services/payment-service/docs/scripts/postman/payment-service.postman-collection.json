          "name": "Verify Agent Payment Method",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{payment_base_url}}/api/v1/agents/{{agent_id}}/payment-methods/{{payment_method_id}}/verify",
              "host": [
                "{{payment_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "agents",
                "{{agent_id}}",
                "payment-methods",
                "{{payment_method_id}}",
                "verify"
              ]
            },
            "description": "Run this before Set Default in a fresh environment if verification is enforced as a precondition \u2014 check VerifyAgentPaymentMethodHandler for the exact rule.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethodId\": \"{{payment_method_id}}\",\n  \"verificationToken\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
