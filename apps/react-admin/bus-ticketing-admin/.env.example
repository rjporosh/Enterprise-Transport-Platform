VITE_API_BASE_URL=/api/v1

# Demo mode (default false): auth-service, booking-service, bus-service and
# route-service are implemented and reachable — see src/api/mockAdapter.ts
# for exactly which paths route to them vs. which two (no dashboard-stats
# or user-management backend exists anywhere yet) stay mocked either way.
# Set to true for a fully backend-less demo/click-through with `npm run dev`.
VITE_USE_MOCK_API=false
