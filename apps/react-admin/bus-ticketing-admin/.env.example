# API base path. Relative — routed by the Vite dev proxy (see vite.config.ts)
# or the production nginx to the ONE platform API gateway. There are no direct
# service URLs in this app (M0).
VITE_API_BASE_URL=/api/v1

# Demo mode (default false): with the gateway + services running the admin
# console talks to the real backend. A few list/aggregation screens
# (dashboard stats, users, plain bookings/trips lists) still fall back to the
# in-app mock even in real mode because no backend endpoint exists yet — see
# src/api/mockAdapter.ts and docs/API-GAPS.md. Set to true for a fully
# backend-less click-through.
VITE_USE_MOCK_API=false
