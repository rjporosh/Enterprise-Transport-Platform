<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform.Contracts — versionable, language-neutral integration-event
    contracts and their stable RabbitMQ routing keys.

    Rules:
      * Pure POCOs / constants. No dependencies, no ASP.NET, no EF, no MediatR.
      * A routing key, once published, never changes meaning (.ai/MASTER-RULES.md §48/§82).
      * Never derive a routing key from a CLR type name / AssemblyQualifiedName
        (that was the P0-4 bug). Keys are explicit constants in EventTypes.
      * Node.js / Java / Python services consume these same keys + JSON shapes.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <RootNamespace>Platform.Contracts</RootNamespace>
    <AssemblyName>Platform.Contracts</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Integration event contracts and stable routing keys for the Enterprise Transport Platform.</Description>
  </PropertyGroup>

  <!-- The test project lives under tests/ inside this directory; keep its
       sources (and build output) out of this library's compilation. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
    <None Remove="tests/**/*" />
    <EmbeddedResource Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Platform.Contracts.Tests" />
  </ItemGroup>

</Project>
